{
  "sourceLanguage": "en",
  "strings": {
    "CFBundleDisplayName": {
      "comment": "Bundle display name",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenBean"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenBean"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription": {
      "comment": "Privacy - Bluetooth Always Usage Description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenBean connects to your soundcore Work recorder to sync its recordings to this iPhone, also in the background when the recorder goes back in its case in Heart mode."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenBean 通过蓝牙连接你的 soundcore Work 录音豆，把录音同步到这台 iPhone；心力模式下录音豆放回充电盒时，在后台也会同步。"
          }
        }
      }
    },
    "NSLocalNetworkUsageDescription": {
      "comment": "Privacy - Local Network Usage Description",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenBean connects to your recorder over its own Wi‑Fi to sync recordings faster, and to the LLM service you set in Settings when it runs on your local network."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经 Wi‑Fi 同步时，OpenBean 要经录音豆自己的 Wi‑Fi 连接它来下载录音；你在设置里填的大模型服务在局域网里时，也要连接它来写摘要和日记。"
          }
        }
      }
    }
  },
  "version": "1.0"
}
