    "Transcripts are sent to %@ to write summaries. Audio never leaves this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写文字会发送给 %@ 来写摘要，音频不会离开手机。"
          }
        }
      }
    },
    "Transcripts, summaries and the diary are always kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写、摘要和日记一直保留。"
          }
        }
      }
    },
    "Transcripts, summaries and the diary are kept. Applies to recordings synced in Heart mode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写、摘要和日记都会保留。只对心力模式下同步的录音生效。"
