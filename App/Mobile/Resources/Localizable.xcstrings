    "The service took too long to answer.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "服务太久没有回应。"
          }
        }
      }
    },
    "Things": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "事"
          }
        }
      }
    },
    "This iPhone can't use Apple Intelligence, or Apple Intelligence isn't offered in your region. Use a cloud or network service instead.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 不能使用 Apple 智能，或所在地区未提供 Apple 智能。请改用云端或局域网服务。"
          }
        }
      }
    },
    "This iPhone is offline.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 没有联网。"
          }
        }
      }
    },
    "This is not a valid address. It should start with https:// (or http:// on your local network).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址无效，应以 https:// 开头（局域网里可以用 http://）。"
          }
        }
      }
    },
    "This recording is too short to summarise.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条录音太短，没有可摘要的内容。"
          }
        }
      }
    },
    "To write summaries, conversation titles and the diary, the text of your transcripts will be sent to %@. Audio never leaves this iPhone. You can switch back to the on-device model at any time.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为了写摘要、对话标题和日记，转写文字会发送给 %@。音频不会离开手机。你随时可以切回端侧模型。"
          }
        }
      }
    },
    "To-dos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待办"
          }
        }
      }
    },
    "Today": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天"
          }
        }
      }
    },
    "Today's diary is updated.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的日记已更新。"
          }
        }
