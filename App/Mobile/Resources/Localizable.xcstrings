        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步后转写"
          }
        }
      }
    },
    "Transcribe the recording first.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先转写这条录音。"
