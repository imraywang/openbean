    },
    "Transcribes on this iPhone and splits the day into conversations.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在这台 iPhone 上转写，并把一天切成一段段对话。"
          }
        }
      }
    },
    "Transcribing %lld%%": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
