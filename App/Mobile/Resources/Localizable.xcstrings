    "Keep": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一直保留"
          }
        }
      }
    },
    "Keep Bluetooth on. If you swipe OpenBean away in the app switcher, iOS stops waking it in the background until you open it again. Transcribing and the diary run when iOS allows it, or when you open OpenBean.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请保持蓝牙打开。在多任务界面把 OpenBean 划掉后，iOS 不会再在后台唤醒它，直到你再次打开。转写和日记在 iOS 允许时在后台做，或者在你打开 OpenBean 时做。"
          }
        }
      }
    },
    "Keep audio": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保留音频"
          }
        }
