        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何 OpenAI 兼容的服务：云端 API，或局域网里一台电脑上的模型。摘要、对话段标题和日记都用它。密钥存在钥匙串里。"
          }
        }
      }
    },
