    "OpenBean isn't allowed on your local network. Turn on Local Network for OpenBean in the Settings app (Privacy & Security → Local Network).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenBean 没有本地网络权限。请在「设置」App 的「隐私与安全性 → 本地网络」里打开 OpenBean。"
