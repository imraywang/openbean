{
  "sourceLanguage": "en",
  "version": "1.0",
  "strings": {
    "%@ of %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@，共 %2$@"
          }
        }
      }
    },
    "%@ of %@ used": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已用 %@，共 %@"
          }
        }
      }
    },
    "%@ · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ · %@"
          }
        }
      }
    },
    "%lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld"
          }
        }
      }
    },
    "%lld conversations · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 段 · %2$@"
          }
        }
      }
    },
    "%lld deleted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已删 %lld 条"
          }
        }
      }
    },
    "%lld deleted from the Heart bean": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从心力豆删了 %lld 条"
          }
        }
      }
    },
    "%lld downloaded": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已下载 %lld 条"
          }
        }
      }
    },
    "%lld failed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条没成功"
          }
        }
      }
    },
    "%lld h %lld min": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 小时 %2$lld 分钟"
          }
        }
      }
    },
    "%lld kept": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "留下 %lld 条"
          }
        }
      }
    },
    "%lld left, tries again later": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "还剩 %lld 条，稍后再试"
          }
        }
      }
    },
    "%lld marks": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个重点标记"
          }
        }
      }
    },
    "%lld matches": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 处命中"
          }
        }
      }
    },
    "%lld min": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 分钟"
          }
        }
      }
    },
    "%lld new recordings are on the Heart bean.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心力豆上有 %lld 条新录音。"
          }
        }
      }
    },
    "%lld new recordings are on the recorder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音豆上有 %lld 条新录音。"
          }
        }
      }
    },
    "%lld new recordings on the Heart bean": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心力豆上有 %lld 条新录音"
          }
        }
      }
    },
    "%lld new recordings on the recorder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音豆上有 %lld 条新录音"
          }
        }
      }
    },
    "%lld of %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld / %lld"
          }
        }
      }
    },
    "%lld of %lld done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已完成 %1$lld / %2$lld"
          }
        }
      }
    },
    "%lld of them only have a transcript left: their audio was removed under Heart mode's audio retention.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "其中 %lld 条只剩转写：音频已按心力模式的音频保留设置删掉。"
          }
        }
      }
    },
    "%lld open to-dos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条待办没做"
          }
        }
      }
    },
    "%lld recordings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条录音"
          }
        }
      }
    },
    "%lld recordings from this day aren't transcribed yet": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这天有 %lld 条录音还没转写"
          }
        }
      }
    },
    "%lld recordings only have a transcript left: their audio was removed under Heart mode's audio retention.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条录音只剩转写：音频已按心力模式的音频保留设置删掉。"
          }
        }
      }
    },
    "%lld recordings synced and transcribed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步并转写了 %lld 条录音。"
          }
        }
      }
    },
    "%lld recordings synced.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "同步了 %lld 条录音。"
          }
        }
      }
    },
    "%lld split": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已切 %lld 条"
          }
        }
      }
    },
    "%lld stayed on the Heart bean because they couldn't be checked against the copy on this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条留在了心力豆上：没能和这台 iPhone 上的副本核对一致。"
          }
        }
      }
    },
    "%lld terms": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 个词条"
          }
        }
      }
    },
    "%lld to do": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 项待办"
          }
        }
      }
    },
    "%lld to-dos": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld 条待办"
          }
        }
      }
    },
    "%lld transcribed": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已转写 %lld 条"
          }
        }
      }
    },
    "%lld · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$lld 条 · %2$@"
          }
        }
      }
    },
    "%lld%%, charging": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%lld%%，充电中"
          }
        }
      }
    },
    "127.0.0.1 and localhost mean this iPhone, which has no model server. Use the address of the computer on your network, such as http://192.168.1.20:11434.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "127.0.0.1 和 localhost 指的是这台 iPhone 自己，手机上没有模型服务。请填局域网里那台电脑的地址，例如 http://192.168.1.20:11434。"
          }
        }
      }
    },
    "7 days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天"
          }
        }
      }
    },
    "A day starts at": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一天从几点开始"
          }
        }
      }
    },
    "A few words": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有几句话"
          }
        }
      }
    },
    "A notification when today's record is updated or something needs you (iOS asks once).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "今天的记录更新了、或者有事要你处理时发通知（iOS 会问一次）。"
          }
        }
      }
    },
    "A secure connection couldn't be made (certificate problem or a proxy in the way).": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法建立加密连接（证书有问题，或被代理拦截）。"
          }
        }
      }
    },
    "A summary can be written once the recording is transcribed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写完成后才能写摘要。"
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key"
          }
        }
      }
    },
    "API key (if the server needs one)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API 密钥（服务需要时才填）"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "About %@ left over Bluetooth. Over Wi‑Fi the rest takes about %@.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙还要约 %1$@。改用 Wi‑Fi，剩下的约 %2$@ 就能传完。"
          }
        }
      }
    },
    "About %@ over Bluetooth.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经蓝牙大约要 %@。"
          }
        }
      }
    },
    "About %@ over Bluetooth. It keeps going in the background; if it's interrupted, it picks up where it stopped.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "经蓝牙大约要 %@。切到后台也会继续；中途断了，下次从断开的地方接着传。"
          }
        }
      }
    },
    "About %@ over Wi‑Fi, with OpenBean kept open.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用 Wi‑Fi 约 %@，期间要让 OpenBean 留在前台。"
          }
        }
      }
    },
    "Add": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加"
          }
        }
      }
    },
    "Add a term": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加词条"
          }
        }
      }
    },
    "Add names and words that transcripts get wrong.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "把转写里常写错的人名、词加进来。"
          }
        }
      }
    },
    "Add what it hears": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "添加它听成的写法"
          }
        }
      }
    },
    "Address": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "地址"
          }
        }
      }
    },
    "After each sync": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每次同步之后"
          }
        }
      }
    },
    "All done": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部完成"
          }
        }
      }
    },
    "All sources": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部来源"
          }
        }
      }
    },
    "Allow": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "允许"
          }
        }
      }
    },
    "Allow Bluetooth for OpenBean in Settings → OpenBean.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「设置 → OpenBean」里允许蓝牙。"
          }
        }
      }
    },
    "Always on in Heart mode, over Bluetooth, also in the background.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "心力模式下一直开着，走蓝牙，在后台也会同步。"
          }
        }
      }
    },
    "Any OpenAI-compatible service. A model server on a computer at home (llama-server, Ollama, LM Studio) works too: use its address on your Wi‑Fi. The key is kept in the keychain.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "任何 OpenAI 兼容服务都行。家里电脑上的模型服务（llama-server、Ollama、LM Studio）也可以：填它在 Wi‑Fi 里的地址。密钥存在钥匙串里。"
          }
        }
      }
    },
    "Any status": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部状态"
          }
        }
      }
    },
    "Apple Intelligence is off": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能未打开"
          }
        }
      }
    },
    "Apple Intelligence is still getting its model ready. Keep the iPhone on Wi‑Fi and charging, and try again later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 智能的模型还在准备中。请让 iPhone 连着 Wi‑Fi 并充电，稍后再试。"
          }
        }
      }
    },
    "Apple on-device": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "苹果端侧模型"
          }
        }
      }
    },
    "Apple on-device model": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "苹果端侧模型"
          }
        }
      }
    },
    "Apple's on-device model needs iOS 26 or later.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "苹果端侧模型需要 iOS 26 或更高版本。"
          }
        }
      }
    },
    "Asking the Heart bean to start its Wi‑Fi…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在让心力豆开启 Wi‑Fi…"
          }
        }
      }
    },
    "Asking the recorder to start its Wi‑Fi…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在让录音豆开启 Wi‑Fi…"
          }
        }
      }
    },
    "Audio": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频"
          }
        }
      }
    },
    "Audio (Ogg Opus)": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频（Ogg Opus）"
          }
        }
      }
    },
    "Audio on this iPhone is kept for 7 days.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上的音频保留 7 天。"
          }
        }
      }
    },
    "Audio on this iPhone is kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上的音频一直保留。"
          }
        }
      }
    },
    "Audio on this iPhone is removed once it's transcribed.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这台 iPhone 上的音频转写完就删除。"
          }
        }
      }
    },
    "Audio removed on %@ under Heart mode's audio retention. The transcript and summary are kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频已于 %@ 按心力模式的音频保留设置删掉，转写和摘要还在。"
          }
        }
      }
    },
    "Audio retention": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频保留"
          }
        }
      }
    },
    "Audio that can be removed now": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "现在可以删的音频"
          }
        }
      }
    },
    "Audio, transcripts and the diary are kept on this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频、转写和日记都存在这台 iPhone 上。"
          }
        }
      }
    },
    "Back 15 seconds": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后退 15 秒"
          }
        }
      }
    },
    "Background": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "后台"
          }
        }
      }
    },
    "Battery": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "电量"
          }
        }
      }
    },
    "Bluetooth is off": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙已关闭"
          }
        }
      }
    },
    "Can't find this server. Check the address.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到这个服务器，请检查地址。"
          }
        }
      }
    },
    "Can't find your recorder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到录音豆"
          }
        }
      }
    },
    "Can't reach this address on your local network. Check that the computer is on and on the same Wi‑Fi, and that Local Network is allowed for OpenBean in the Settings app.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上局域网里的这个地址。请确认电脑开着、和手机在同一个 Wi‑Fi，并在「设置」App 里允许 OpenBean 访问本地网络。"
          }
        }
      }
    },
    "Cancel": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "取消"
          }
        }
      }
    },
    "Change in Settings": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "去设置里修改"
          }
        }
      }
    },
    "Charging case": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "充电盒"
          }
        }
      }
    },
    "Check again": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "再检查一次"
          }
        }
      }
    },
    "Checking earlier recordings… %lld of %lld": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查以前的录音…… 第 %1$lld 条，共 %2$lld 条"
          }
        }
      }
    },
    "Checking the LLM service…": {
