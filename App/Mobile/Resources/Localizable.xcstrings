      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写这天的日记"
          }
        }
      }
    },
    "Writes today's diary and to-dos with your LLM service.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "用你的大模型服务写当天的日记和待办。"
          }
        }
      }
    },
