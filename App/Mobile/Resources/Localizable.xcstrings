            "state": "translated",
            "value": "事"
          }
        }
      }
    },
    "This conversation is no longer here": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这段对话已经不在了"
          }
        }
      }
    },
    "This recording is too short to summarise.": {
      "localizations": {
        "zh-Hans": {
