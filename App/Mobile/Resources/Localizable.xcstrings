            "value": "地址无效，应以 https:// 开头（局域网里可以用 http://）。"
          }
        }
      }
    },
    "This recording is no longer on this iPhone.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这条录音已经不在这台 iPhone 上了。"
          }
