    "OpenBean disconnects and searches again. Nothing on the recorder changes.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenBean 会断开并重新搜索，录音豆上的内容不会有任何改动。"
          }
        }
      }
    },
    "OpenBean never pairs, unbinds, resets, deletes recordings on or updates the recorder.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "OpenBean 不会对录音豆做配对、解绑、恢复出厂、删除录音或固件升级。"
          }
        }
      }
    },
