      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "提到的人和事"
          }
        }
      }
    },
    "People mentioned": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
