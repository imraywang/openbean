    "%lld new recordings are on the recorder. Sync them once it connects.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音豆上有 %lld 条新录音，连上后就能同步。"
          }
        }
      }
    },
    "%lld new recordings on the recorder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音豆上有 %lld 条新录音"
