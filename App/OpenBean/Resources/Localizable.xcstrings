    "7 days": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "7 天"
          }
        }
      }
    },
    "A day starts at": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "一天从几点开始"
          }
        }
      }
    },
    "A diary for each day is part of Heart mode": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每日日记现在是心力模式的一部分"
          }
        }
      }
    },
    "A few words": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只有几句话"
          }
        }
      }
    },
    "A soft tick when the bar turns into a microphone": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "悬浮条变成麦克风时轻响一声"
          }
        }
      }
    },
    "A too-short phrase pause chops sentences and hurts accuracy. Restart OpenBean after changing it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定稿停顿太短会把句子切碎、降低准确率。修改后需要重启 OpenBean。"
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "API Key"
          }
        }
      }
    },
    "About": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关于"
          }
        }
      }
    },
    "About %@ over Bluetooth": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙约需 %@"
          }
        }
      }
    },
    "About %@ over Bluetooth. Use Sync in the toolbar.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "蓝牙约需 %@，用工具栏里的「同步」。"
          }
        }
      }
    },
    "About 100× faster than Bluetooth. Your Mac joins the recorder's own Wi‑Fi and is offline for about a minute, then reconnects to your usual network.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "比蓝牙快约 100 倍。Mac 会临时加入录音豆自己的 Wi‑Fi，断网约一分钟，之后自动连回原来的网络。"
          }
        }
      }
    },
    "About this recorder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备信息"
          }
        }
      }
    },
    "Accessibility permission granted": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "辅助功能已授权"
          }
        }
      }
    },
    "Action items": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "待办事项"
          }
        }
      }
    },
    "Add ⌘, ⌥ or ⌃": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "需要带 ⌘、⌥ 或 ⌃"
