            "value": "地址无效"
          }
        }
      }
    },
    "less than a minute": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不到 1 分钟"
          }
        }
      }
    },
    "media": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "媒体声"
          }
        }
      }
    },
    "recorder. Take it out of the case or press the case button to wake it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "录音豆。请把它从充电盒拿出来，或按一下充电盒按钮唤醒。"
          }
        }
      }
    },
    "starts at %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
