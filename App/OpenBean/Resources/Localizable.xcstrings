    "Transcribing…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在转写…"
          }
        }
      }
    },
    "Transcript": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全文"
          }
        }
      }
    },
    "Transcripts are sent to %@ for summaries.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "生成摘要时转写文字会发送到 %@。"
          }
        }
      }
    },
    "Transcripts, summaries and the diary are kept. Applies to recordings synced in Heart mode.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转写、摘要和日记都会保留。只对心力模式下同步的录音生效。"
          }
        }
      }
    },
    "Trigger": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发"
          }
        }
      }
    },
    "Try it": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试一试"
          }
        }
      }
    },
    "Try voice typing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试语音输入"
          }
        }
      }
    },
    "Turn on Bluetooth in Control Center or System Settings. OpenBean connects as soon as it's on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在控制中心或系统设置里打开蓝牙，打开后 OpenBean 会自动连接。"
          }
        }
      }
    },
    "Turn on OpenBean in System Settings → Privacy & Security → Bluetooth.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系统设置 → 隐私与安全性 → 蓝牙」里打开 OpenBean。"
          }
        }
      }
    },
    "Type into the active app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打字到当前 App"
          }
        }
      }
    },
    "Typed %lld characters": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已输入 %lld 字"
          }
        }
      }
    },
    "Untitled recording": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命名录音"
          }
        }
      }
    },
    "Use your soundcore Work recorder on this Mac — no vendor app, no cloud.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上直接使用你的 soundcore Work 录音豆，不需要官方 App，也不经过云端。"
          }
        }
      }
    },
    "Version": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "版本"
          }
        }
      }
    },
    "Voice typing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入"
          }
        }
      }
    },
    "Voice typing %lld times · %lld characters": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入 %1$lld 次 · %2$lld 字"
          }
        }
      }
    },
    "Voice typing is using the recorder": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入正在用录音豆"
          }
        }
      }
    },
    "Voice-typing files": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "语音输入文件"
          }
        }
      }
    },
    "Wear your Heart bean all day. When it goes back in its case, OpenBean syncs the day, splits it into conversations and writes today's diary and to-dos.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "戴着心力豆过一天。放回充电盒后，OpenBean 自动同步、把这一天切成一段段对话，写好今天的日记和待办。"
          }
        }
      }
    },
    "Welcome to OpenBean": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "欢迎使用 OpenBean"
          }
        }
      }
    },
    "With 4:00 AM, a conversation at 2 AM still counts as the day before.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设为凌晨 4 点时，凌晨两点的谈话仍算前一天。"
          }
        }
      }
    },
    "Wi‑Fi firmware": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Wi‑Fi 固件"
          }
        }
      }
    },
    "Wrapping up…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "整理中…"
          }
        }
      }
    },
    "Write the diary for this day": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "写这天的日记"
          }
        }
      }
    },
    "Writing the diary for this day…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在写这天的日记…"
          }
        }
      }
    },
    "Yesterday": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天"
          }
        }
      }
    },
    "Yesterday %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "昨天 %@"
          }
        }
      }
    },
    "You can skip this; text then only appears in OpenBean.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "可以先跳过，文字就只显示在 OpenBean 里。"
          }
        }
      }
    },
    "Your Mac joins the recorder's own Wi‑Fi and is offline for a few minutes, then reconnects to your usual network. What Bluetooth has already received is kept.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Mac 会临时加入录音豆自己的 Wi‑Fi，断网几分钟，之后自动连回原来的网络。蓝牙已经收到的部分会保留。"
          }
        }
      }
    },
    "about %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "约 %@"
          }
        }
      }
    },
    "comma": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "逗号"
          }
        }
      }
    },
