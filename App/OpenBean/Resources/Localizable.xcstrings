    "Choose": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择"
          }
        }
      }
    },
    "Choose a day": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择日期"
          }
        }
      }
    },
    "Choose a folder for recording notes, for example a folder in your Obsidian vault.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择存放录音笔记的文件夹，例如 Obsidian 知识库里的某个文件夹。"
          }
        }
      }
    },
    "Choose a notes folder in Library to also save each day's diary as a Markdown file. Until then it's shown in Today.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「录音库」里选好笔记文件夹，每天的日记也会存成一份 Markdown 文件；没选之前只在「今天」里显示。"
          }
        }
      }
    },
    "Choose a notes folder in Settings → Library.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先在「设置 → 录音库」里选择笔记文件夹。"
          }
        }
      }
    },
    "Choose…": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择…"
          }
        }
      }
    },
