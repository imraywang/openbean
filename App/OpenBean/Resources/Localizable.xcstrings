    "Press the recorder's button and speak. What you say is kept here, on this Mac.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按录音豆的按键说话，说过的内容会保存在这台 Mac 上。"
