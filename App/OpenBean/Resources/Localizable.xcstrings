      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Agent"
          }
        }
      }
    },
    "All transcribed recordings have notes": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已转写的录音都有笔记了"
