        }
      }
    },
    "Press the recorder's button and speak; the text is typed where your cursor is.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按录音豆的按键说话，文字会打进光标所在的位置。"
          }
        }
      }
    },
    "Press the recorder's button to type with your voice": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按录音豆按键，用说话代替打字"
          }
        }
      }
    },
    "Press the recorder's button, speak, then press it again. The text goes where your cursor is.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "按一下录音豆的按键说话，再按一下结束，文字会打到光标所在的位置。"
          }
        }
      }
    },
