    "Untitled recording": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "未命名录音"
          }
        }
      }
    },
    "Use your soundcore Work recorder on this Mac — no vendor app, no cloud.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Mac 上直接使用你的 soundcore Work 录音豆，不需要官方 App，也不经过云端。"
          }
        }
      }
    },
