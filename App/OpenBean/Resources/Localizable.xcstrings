    "A too-short phrase pause chops sentences and hurts accuracy. Restart OpenBean after changing it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "定稿停顿太短会把句子切碎、降低准确率。修改后需要重启 OpenBean。"
          }
        }
      }
    },
    "API key": {
      "localizations": {
        "zh-Hans": {
