    "Try voice typing": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "试试语音输入"
          }
        }
      }
    },
    "Turn on Bluetooth in Control Center or System Settings. OpenBean connects as soon as it's on.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在控制中心或系统设置里打开蓝牙，打开后 OpenBean 会自动连接。"
          }
        }
      }
    },
    "Turn on OpenBean in System Settings → Privacy & Security → Bluetooth.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在「系统设置 → 隐私与安全性 → 蓝牙」里打开 OpenBean。"
          }
        }
      }
    },
    "Type into the active app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打字到当前 App"
          }
        }
