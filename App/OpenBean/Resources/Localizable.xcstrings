        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不到 1 分钟"
          }
        }
      }
    },
    "recorder. Take it out of the case or press the case button to wake it.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
