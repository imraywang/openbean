    "%@ battery is low (%lld%%). Put it back in its case to charge.": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 电量低（%2$lld%%），放回充电盒充电。"
          }
        }
      }
    },
    "%@ is taken by another app": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 已被别的 App 占用"
          }
