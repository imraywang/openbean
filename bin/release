#!/bin/zsh
# 打发布包：Developer ID 签名 + hardened runtime → App 公证钉票 → DMG → DMG 公证钉票 → Gatekeeper 检查
#          → Sparkle 签名 DMG → 更新仓库根目录的 appcast.xml（自动更新的订阅源）
#
#   bin/release              # 全流程，产物 .build/release/OpenBean-<版本>.dmg，并改写 appcast.xml
#   bin/release --no-notarize  # 只签名打包，不公证；appcast 只写到 .build/release/appcast.xml，不动仓库里的
#
# 每次发布前在 App/project.yml 里：MARKETING_VERSION 改成新版本号，CURRENT_PROJECT_VERSION（构建号）加 1。
# Sparkle 按构建号比新旧，构建号只增不减；appcast.xml 里已有这个构建号或版本号时脚本拒绝运行。
#
# Sparkle 的 EdDSA 私钥在登录钥匙串里（generate_keys 生成；钥匙串项的服务名 https://sparkle-project.org、账户 ed25519），
# 公钥写在 App/project.yml 的 SUPublicEDKey。换电脑发布要先把私钥迁过去：
#   generate_keys -x <文件> 导出、新电脑 generate_keys -f <文件> 导入，然后删掉那个文件。
#
# 公证凭据存在钥匙串里，第一次用前在终端执行一次（会提示输入 App 专用密码）：
#   xcrun notarytool store-credentials openbean-notary --apple-id <你的 Apple ID> --team-id ZHPS34Z8M9
# 换名字用 OPENBEAN_NOTARY_PROFILE，换证书用 OPENBEAN_RELEASE_ID / OPENBEAN_TEAM_ID。
set -euo pipefail
ROOT="${0:A:h}/.."
cd "$ROOT"

NOTARIZE=1
[[ "${1:-}" == "--no-notarize" ]] && NOTARIZE=0

TEAM="${OPENBEAN_TEAM_ID:-ZHPS34Z8M9}"
SIGN_ID="${OPENBEAN_RELEASE_ID:-Developer ID Application: UPTHOS LLC ($TEAM)}"
PROFILE="${OPENBEAN_NOTARY_PROFILE:-openbean-notary}"
VERSION=$(sed -nE 's/^ *MARKETING_VERSION: *"?([^"]+)"?/\1/p' App/project.yml | head -1)
BUILD=$(sed -nE 's/^ *CURRENT_PROJECT_VERSION: *"?([^"]+)"?/\1/p' App/project.yml | head -1)
EDKEY=$(sed -nE 's/^ *SUPublicEDKey: *"?([^"]+)"?/\1/p' App/project.yml | head -1)
OUT=.build/release
APP="$OUT/OpenBean.app"
DMG="$OUT/OpenBean-$VERSION.dmg"
APPCAST=appcast.xml
SPARKLE_BIN=App/build-release/SourcePackages/artifacts/sparkle/Sparkle/bin

[[ "$BUILD" == <-> ]] || { echo "CURRENT_PROJECT_VERSION 要是整数：$BUILD"; exit 1; }
# 构建号和版本号都不能和 appcast 里已发布的重复，构建号还要比已有的都大
if [[ -f $APPCAST ]]; then
  builds=$(sed -nE 's/.*<sparkle:version>([0-9]+)<\/sparkle:version>.*/\1/p' $APPCAST)
  versions=$(sed -nE 's/.*<sparkle:shortVersionString>([^<]+)<\/sparkle:shortVersionString>.*/\1/p' $APPCAST)
  for b in ${(f)builds}; do
    (( BUILD > b )) || { echo "构建号 $BUILD 不比 appcast.xml 里已有的 $b 大：先把 App/project.yml 的 CURRENT_PROJECT_VERSION 加 1"; exit 1; }
  done
  for v in ${(f)versions}; do
    [[ "$v" != "$VERSION" ]] || { echo "appcast.xml 里已有版本 $VERSION：先改 App/project.yml 的 MARKETING_VERSION"; exit 1; }
  done
fi

command -v xcodegen >/dev/null || { echo "需要 XcodeGen：brew install xcodegen"; exit 1; }
ids=$(security find-identity -v -p codesigning)
grep -q "\"$SIGN_ID\"" <<<"$ids" || { echo "钥匙串里没有证书：$SIGN_ID"; exit 1; }
if (( NOTARIZE )); then
  xcrun notarytool history --keychain-profile "$PROFILE" >/dev/null 2>&1 || {
    echo "没有公证凭据「$PROFILE」，先执行："
    echo "  xcrun notarytool store-credentials $PROFILE --apple-id <Apple ID> --team-id $TEAM"
    exit 1
  }
fi
[[ -f Vendor/sherpa-onnx/lib/libsherpa-onnx-c-api.dylib ]] || Scripts/fetch-deps.sh

echo "▸ 编译 $VERSION ($BUILD)（$SIGN_ID）"
(cd App && xcodegen generate -q)
rm -rf App/build-release "$OUT"
mkdir -p "$OUT"
xcodebuild -project App/OpenBean.xcodeproj -scheme OpenBean -configuration Release \
  -derivedDataPath App/build-release -quiet -packageAuthorizationProvider netrc \
  CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY="$SIGN_ID" DEVELOPMENT_TEAM="$TEAM" \
  ENABLE_HARDENED_RUNTIME=YES OTHER_CODE_SIGN_FLAGS="--timestamp" CODE_SIGN_INJECT_BASE_ENTITLEMENTS=NO \
  build
ditto App/build-release/Build/Products/Release/OpenBean.app "$APP"

# Sparkle 私钥要在钥匙串里，且和 App 里的公钥是一对；不然发出去的更新没人能装（公证前就拦下）
[[ -x $SPARKLE_BIN/sign_update ]] || { echo "没找到 Sparkle 工具：$SPARKLE_BIN"; exit 1; }
pub=$("$SPARKLE_BIN/generate_keys" -p 2>/dev/null) || { echo "钥匙串里没有 Sparkle 私钥：先运行 $SPARKLE_BIN/generate_keys"; exit 1; }
[[ "$pub" == "$EDKEY" ]] || { echo "钥匙串里的 Sparkle 私钥和 SUPublicEDKey 不是一对：$pub"; exit 1; }

# Xcode 拷贝 Sparkle.framework 时只重签框架本身，里面的辅助程序还是 Sparkle 官方的签名，公证不收。
# 由内到外用 Developer ID + 时间戳 + hardened runtime 重签，最后重签 App
FW="$APP/Contents/Frameworks/Sparkle.framework"
SP="$FW/Versions/B"
SPARKLE_PARTS=("$SP/XPCServices/Installer.xpc" "$SP/XPCServices/Downloader.xpc" "$SP/Autoupdate" "$SP/Updater.app" "$FW")
echo "▸ 重签 Sparkle"
for f in $SPARKLE_PARTS; do
  [[ -e $f ]] || { echo "Sparkle.framework 里缺：$f"; exit 1; }
  codesign --force --sign "$SIGN_ID" --timestamp --options runtime --preserve-metadata=entitlements "$f"
done
codesign --force --sign "$SIGN_ID" --timestamp --options runtime --preserve-metadata=entitlements "$APP"

echo "▸ 检查签名"
codesign --verify --deep --strict --verbose=1 "$APP"
for f in "$APP" "$APP"/Contents/Frameworks/*.dylib $SPARKLE_PARTS; do
  codesign --verify --strict "$f" || { echo "签名校验失败：$f"; exit 1; }
  info=$(codesign -dvv "$f" 2>&1)
  grep -q "Authority=$SIGN_ID" <<<"$info" || { echo "签名不对：$f"; exit 1; }
  grep -q "Timestamp=" <<<"$info" || { echo "缺安全时间戳：$f"; exit 1; }
done
# 可执行的部分都要开 hardened runtime（公证要求）
for f in "$APP" ${SPARKLE_PARTS:#$FW}; do
  info=$(codesign -dv "$f" 2>&1)
  grep -q "flags=.*runtime" <<<"$info" || { echo "没开 hardened runtime：$f"; exit 1; }
done

# 提交公证并等结果；不通过就打印 Apple 的日志后退出
notarize() {
  local file=$1 log=$2
  xcrun notarytool submit "$file" --keychain-profile "$PROFILE" --wait --timeout 30m | tee "$log"
  grep -q "status: Accepted" "$log" || {
    local id=$(sed -nE 's/^ *id: ([0-9a-f-]+).*/\1/p' "$log" | head -1)
    [[ -n "$id" ]] && xcrun notarytool log "$id" --keychain-profile "$PROFILE"
    exit 1
  }
}

if (( NOTARIZE )); then
  # App 先单独公证并钉票：拖出 DMG 后自带票，第一次打开不用联网核对
  echo "▸ 公证 App（通常几分钟）"
  ditto -c -k --keepParent "$APP" "$OUT/OpenBean-app.zip"
  notarize "$OUT/OpenBean-app.zip" "$OUT/notary-app.log"
  rm "$OUT/OpenBean-app.zip"
  xcrun stapler staple "$APP"
  xcrun stapler validate "$APP"
fi

echo "▸ 打 DMG"
STAGE=$(mktemp -d)
ditto "$APP" "$STAGE/OpenBean.app"
ln -s /Applications "$STAGE/Applications"
hdiutil create -quiet -volname "OpenBean $VERSION" -srcfolder "$STAGE" -fs HFS+ -format UDZO -ov "$DMG"
rm -rf "$STAGE"
codesign --sign "$SIGN_ID" --timestamp "$DMG"

if (( NOTARIZE )); then
  echo "▸ 公证 DMG"
  notarize "$DMG" "$OUT/notary-dmg.log"
  xcrun stapler staple "$DMG"
  xcrun stapler validate "$DMG"
  echo "▸ Gatekeeper"
  spctl --assess --type open --context context:primary-signature --verbose=2 "$DMG"
  spctl --assess --type execute --verbose=2 "$APP"
fi

# Sparkle 签名要在钉票之后：钉票会改 DMG 的内容
echo "▸ Sparkle 签名，写 appcast"
edsig=$("$SPARKLE_BIN/sign_update" "$DMG")
sig=$(sed -nE 's/.*sparkle:edSignature="([^"]+)".*/\1/p' <<<"$edsig")
len=$(sed -nE 's/.*length="([0-9]+)".*/\1/p' <<<"$edsig")
[[ -n "$sig" && "$len" == "$(stat -f %z "$DMG")" ]] || { echo "sign_update 输出不对：$edsig"; exit 1; }
python3 -I Scripts/appcast.py "$APPCAST" "$OUT/appcast.xml" --version "$VERSION" --build "$BUILD" \
  --url "https://github.com/imraywang/openbean/releases/download/v$VERSION/${DMG:t}" --length "$len" --signature "$sig"
"$SPARKLE_BIN/sign_update" --verify "$DMG" "$sig"
if (( NOTARIZE )); then
  cp "$OUT/appcast.xml" "$APPCAST"
  echo "已更新 $APPCAST：上传 DMG 到 GitHub Release v$VERSION 后再提交推送（App 从 master 上的这个文件读更新）"
else
  echo "未公证，appcast 只写到 $OUT/appcast.xml（仓库里的 $APPCAST 没动）"
fi

(cd "$OUT" && shasum -a 256 "${DMG:t}" | tee "${DMG:t}.sha256")
echo "完成：$ROOT/$DMG"
